--// ======================== MUSIC REMOTE FINDER ========================
local function findBrookhavenMusicRemote()
    if MusicRemoteChecked then return MusicRemote end
    MusicRemoteChecked = true
    local candidates = {
        "PlayMusic", "MusicEvent", "PlaySong", "SetMusic", "RadioEvent",
        "MusicRemote", "BoomboxEvent", "PlayAudio", "SoundEvent",
        "FireMusic", "SongEvent", "Music", "Radio", "Boombox"
    }
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local n = obj.Name:lower()
            if n:find("music") or n:find("song") or n:find("radio") or n:find("boombox") or n:find("audio") then
                print("[Shaw Hub] Music candidate: " .. obj:GetFullName())
            end
        end
    end
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local lower = obj.Name:lower()
            for _, name in ipairs(candidates) do
                if lower == name:lower() or lower:find(name:lower()) then
                    print("[Shaw Hub] Found music remote: " .. obj:GetFullName())
                    MusicRemote = obj
                    return obj
                end
            end
        end
    end
    return nil
end


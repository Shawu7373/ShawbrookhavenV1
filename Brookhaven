local function tryUnlockGamepasses()
    if not CachedGPUnlockRemotes then
        CachedGPUnlockRemotes = {}
        local remoteNames = {"UnlockAll","UnlockGamepass","BuyGamepass","GrantPass","GamepassUnlock","PurchasePass","UnlockPass","SetGamepass"}
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                for _, name in ipairs(remoteNames) do
                    if obj.Name:lower():find(name:lower()) then
                        table.insert(CachedGPUnlockRemotes, obj); break
                    end
                end
            end
        end
    end
    local unlocked = 0
    for _, obj in ipairs(CachedGPUnlockRemotes) do
        pcall(function()
            if obj:IsA("RemoteEvent") then obj:FireServer() else obj:InvokeServer() end
            unlocked = unlocked + 1
        end)
    end
    if unlocked > 0 then safeNotify("Gamepass Unlock", "Fired " .. unlocked .. " remote(s).", 3)
    else safeNotify("Gamepass Unlock", "No unlock remotes found.", 3) end
end


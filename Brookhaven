local function updateVehicleFly()
    if not S.VehicleFly then
        stopVehicleFly()
        CachedVehicle = nil
        return
    end
    if not CachedVehicle or not CachedVehicle.Parent then
        CachedVehicle = getCurrentVehicle()
    end
    local vehicle = CachedVehicle
    if not vehicle then stopVehicleFly(); return end
    local primary = vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart")
    if not primary then return end

    if not VehicleBV or VehicleBV.Parent ~= primary then
        stopVehicleFly()
        VehicleBV = Instance.new("BodyVelocity")
        VehicleBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        VehicleBV.P = 1250
        VehicleBV.Parent = primary
        VehicleBG = Instance.new("BodyGyro")
        VehicleBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        VehicleBG.P = 9e4
        VehicleBG.D = 500
        VehicleBG.Parent = primary
    end

    local cam = Workspace.CurrentCamera
    if not cam then return end

    local moveDir = Vector3.zero
    local camLook = cam.CFrame.LookVector
    local camRight = cam.CFrame.RightVector

    if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camLook end
    if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camLook end
    if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camRight end
    if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camRight end
    if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
    if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end

    if moveDir.Magnitude > 0.01 then moveDir = moveDir.Unit end
    VehicleBV.Velocity = moveDir * S.VehicleFlySpeed
    VehicleBG.CFrame = cam.CFrame
end


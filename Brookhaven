local function executeCommand(text)
    text = text:gsub("^;", ""):gsub("^/", ""):gsub("^%s+", ""):gsub("%s+$", "")
    local args = {}
    for word in text:gmatch("%S+") do table.insert(args, word) end
    if #args == 0 then return end
    local cmd = args[1]:lower()
    local a1 = args[2]

    if cmd == "fly" then S.Fly = true; startFly(); safeNotify("Cmd", "Fly ON", 2)
    elseif cmd == "unfly" then S.Fly = false; stopFly(); safeNotify("Cmd", "Fly OFF", 2)
    elseif cmd == "speed" then local n = tonumber(a1); if n then S.Speed = n; S.SpeedEnabled = true; safeNotify("Cmd", "Speed = " .. n, 2) end
    elseif cmd == "jump" then local n = tonumber(a1); if n then S.JumpPower = n; S.JumpEnabled = true; safeNotify("Cmd", "Jump = " .. n, 2) end
    elseif cmd == "gravity" then local n = tonumber(a1); if n then S.Gravity = n; S.GravityEnabled = true; safeNotify("Cmd", "Gravity = " .. n, 2) end
    elseif cmd == "noclip" then S.Noclip = true; setNoclip(true); safeNotify("Cmd", "Noclip ON", 2)
    elseif cmd == "clip" or cmd == "unnoclip" then S.Noclip = false; setNoclip(false); safeNotify("Cmd", "Noclip OFF", 2)
    elseif cmd == "god" then S.Godmode = true; safeNotify("Cmd", "God ON", 2)
    elseif cmd == "ungod" then S.Godmode = false; safeNotify("Cmd", "God OFF", 2)
    elseif cmd == "heal" then healSelf()
    elseif cmd == "feed" then feedSelf()
    elseif cmd == "invisible" then S.Invisible = true; applyInvisibility(); safeNotify("Cmd", "Invisible ON", 2)
    elseif cmd == "visible" then S.Invisible = false; applyInvisibility(); safeNotify("Cmd", "Visible", 2)
    elseif cmd == "tpwalk" then S.TpWalk = not S.TpWalk; safeNotify("Cmd", "TpWalk: " .. tostring(S.TpWalk), 2)
    elseif cmd == "wallwalk" then S.WallWalk = not S.WallWalk; safeNotify("Cmd", "WallWalk: " .. tostring(S.WallWalk), 2)
    elseif cmd == "float" then S.Float = not S.Float; safeNotify("Cmd", "Float: " .. tostring(S.Float), 2)
    elseif cmd == "anchor" then S.Anchor = not S.Anchor; setAnchor(S.Anchor); safeNotify("Cmd", "Anchor: " .. tostring(S.Anchor), 2)
    elseif cmd == "goto" then if a1 then local target = Players:FindFirstChild(a1); if target then teleportToPlayer(target) else safeNotify("Cmd", "Player not found.", 2) end end
    elseif cmd == "bring" then
        if a1 then
            local target = Players:FindFirstChild(a1)
            if target and target.Character then
                local root = getRoot()
                local tr = target.Character:FindFirstChild("HumanoidRootPart")
                if root and tr then
                    pcall(function() tr.CFrame = root.CFrame + Vector3.new(0, 3, 3) end)
                    safeNotify("Cmd", "Brought " .. target.Name, 2)
                end
            end
        end
    elseif cmd == "stare" then if a1 then local target = Players:FindFirstChild(a1); if target then stareAt(target) end end
    elseif cmd == "rejoin" then pcall(function() TeleportService:Teleport(game.PlaceId, LP) end)
    elseif cmd == "help" then safeNotify("Commands", "fly, unfly, speed N, jump N, gravity N, noclip, clip, god, ungod, heal, feed, invisible, visible, tpwalk, wallwalk, float, anchor, goto NAME, bring NAME, stare NAME, rejoin", 8)
    else safeNotify("Cmd", "Unknown command: " .. cmd, 2) end
end


local function loadSongs()
    ensureFolder()
    if type(isfile) == "function" and type(readfile) == "function" then
        local ok2, exists = pcall(isfile, SAVE_FILE)
        if ok2 and exists then
            local ok3, content = pcall(readfile, SAVE_FILE)
            if ok3 then
                local ok4, decoded = pcall(function() return HttpService:JSONDecode(content) end)
                if ok4 and type(decoded) == "table" then
                    SavedSongs = decoded
                    return
                end
            end
        end
    end
    SavedSongs = {}
end

local function saveSongs()
    ensureFolder()
    if type(writefile) ~= "function" then return end
    local ok2, encoded = pcall(function() return HttpService:JSONEncode(SavedSongs) end)
    if not ok2 then return end
    pcall(writefile, SAVE_FILE, encoded)
end

local function addSong(id, name)
    if not id or id == "" then return false end
    for _, s in ipairs(SavedSongs) do
        if s.id == id then safeNotify("Music", "Song already saved.", 2); return false end
    end
    table.insert(SavedSongs, {id = id, name = name or ("Song " .. id)})
    saveSongs(); safeNotify("Music", "Saved: " .. (name or id), 2)
    return true
end

local function removeSong(id)
    for i, s in ipairs(SavedSongs) do
        if s.id == id then
            table.remove(SavedSongs, i); saveSongs()
            safeNotify("Music", "Removed: " .. (s.name or id), 2)
            return true
        end
    end
    return false
end

local function startFly()

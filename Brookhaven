local function stareAt(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then safeNotify("Stare", "Player not found.", 2); return end
    local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    local cam = Workspace.CurrentCamera
    if hum and cam then
        cam.CameraSubject = hum; StareTarget = targetPlayer
        safeNotify("Stare", "Now staring at " .. targetPlayer.Name, 2)
    end
end

local function vehicleGoto(targetPlayer)
    local vehicle = getCurrentVehicle()
    if not vehicle then safeNotify("Vehicle", "You are not in a vehicle.", 2); return end
    if not targetPlayer or not targetPlayer.Character then safeNotify("Vehicle", "Player not found.", 2); return end
    local primary = vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart")
    local tr = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if primary and tr then
        pcall(function() primary.CFrame = tr.CFrame + Vector3.new(0, 5, 5) end)
        safeNotify("Vehicle", "Vehicle teleported to " .. targetPlayer.Name, 2)
    end
end

local function dropVehicle()
    local vehicle = getCurrentVehicle()
    if not vehicle then safeNotify("Vehicle", "You are not in a vehicle.", 2); return end
    local primary = vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart")
    local root = getRoot()
    if primary and root then pcall(function() primary.CFrame = root.CFrame + Vector3.new(0, 5, 5) end) end
end

local function ejectSelf()
    local hum = getHum()
    if hum and hum.SeatPart then
        pcall(function() hum.Sit = false end)
        safeNotify("Vehicle", "Ejected.", 2)
    end
end

local function findPlayerByPrefix(prefix)
    if not prefix or prefix == "" then return nil end
    local p = prefix:lower()
    if p == "r" or p == "random" then
        local others = {}
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LP then table.insert(others, pl) end
        end
        if #others == 0 then return nil end
        return others[math.random(1, #others)]
    end
    local prefixMatch = nil
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP then
            local nameLower = pl.Name:lower()
            local dispLower = pl.DisplayName:lower()
            if nameLower == p or dispLower == p then return pl end
            if not prefixMatch then
                if nameLower:sub(1, #p) == p or dispLower:sub(1, #p) == p then
                    prefixMatch = pl
                end
            end
        end
    end
    return prefixMatch
end

local function executeCommand(text)
    if not text then return end
    text = text:gsub("^;", ""):gsub("^/", ""):gsub("^%s+", ""):gsub("%s+$", "")
    local args = {}
    for word in text:gmatch("%S+") do table.insert(args, word) end
    if #args == 0 then return end
    local cmd = args[1]:lower()
    local a1 = args[2]; local a2 = args[3]

    if cmd == "fly" then S.Fly = true; startFly(); safeNotify("Cmd", "Fly ON", 2)
    elseif cmd == "unfly" then S.Fly = false; stopFly(); safeNotify("Cmd", "Fly OFF", 2)
    elseif cmd == "speed" then local n = tonumber(a1); if n then S.Speed = n; S.SpeedEnabled = true; safeNotify("Cmd", "Speed = " .. n, 2) end
    elseif cmd == "jump" then local n = tonumber(a1); if n then S.JumpPower = n; S.JumpEnabled = true; safeNotify("Cmd", "Jump = " .. n, 2) end
    elseif cmd == "gravity" then local n = tonumber(a1); if n then S.Gravity = n; S.GravityEnabled = true; safeNotify("Cmd", "Gravity = " .. n, 2) end
    elseif cmd == "noclip" then S.Noclip = true; setNoclip(true); safeNotify("Cmd", "Noclip ON", 2)
    elseif cmd == "clip" or cmd == "unnoclip" then S.Noclip = false; setNoclip(false); safeNotify("Cmd", "Noclip OFF", 2)
    elseif cmd == "god" then S.Godmode = true; safeNotify("Cmd", "God ON", 2)
    elseif cmd == "ungod" then S.Godmode = false; safeNotify("Cmd", "God OFF", 2)
    elseif cmd == "heal" then healSelf()
    elseif cmd == "feed" then feedSelf()
    elseif cmd == "invisible" then S.Invisible = true; applyInvisibility(); safeNotify("Cmd", "Invisible ON", 2)
    elseif cmd == "visible" then S.Invisible = false; applyInvisibility(); safeNotify("Cmd", "Visible", 2)
    elseif cmd == "tpwalk" then S.TpWalk = not S.TpWalk; safeNotify("Cmd", "TpWalk: " .. tostring(S.TpWalk), 2)
    elseif cmd == "wallwalk" then S.WallWalk = not S.WallWalk; safeNotify("Cmd", "WallWalk: " .. tostring(S.WallWalk), 2)
    elseif cmd == "float" then S.Float = not S.Float; safeNotify("Cmd", "Float: " .. tostring(S.Float), 2)
    elseif cmd == "anchor" then S.Anchor = not S.Anchor; setAnchor(S.Anchor); safeNotify("Cmd", "Anchor: " .. tostring(S.Anchor), 2)
    elseif cmd == "goto" or cmd == "tp" then
        local targetStr = a1
        if targetStr and targetStr:lower() == "to" then targetStr = a2 end
        if targetStr then
            local target = findPlayerByPrefix(targetStr)
            if target then teleportToPlayer(target)
            else safeNotify("Cmd", "No player matching: " .. targetStr, 2) end
        else safeNotify("Cmd", "Usage: ;tp to r | ;tp to ca", 2) end
    elseif cmd == "bring" then
        local targetStr = a1
        if targetStr and targetStr:lower() == "to" then targetStr = a2 end
        if targetStr then
            local target = findPlayerByPrefix(targetStr)
            if target then bringPlayer(target)
            else safeNotify("Cmd", "No player matching: " .. targetStr, 2) end
        end
    elseif cmd == "stare" then
        local targetStr = a1
        if targetStr and targetStr:lower() == "to" then targetStr = a2 end
        if targetStr then
            local target = findPlayerByPrefix(targetStr)
            if target then stareAt(target) end
        end
    elseif cmd == "rejoin" then pcall(function() TeleportService:Teleport(game.PlaceId, LP) end)
    elseif cmd == "help" then
        safeNotify("Commands", "fly, unfly, speed N, jump N, gravity N, noclip, clip, god, ungod, heal, feed, invisible, visible, tpwalk, wallwalk, float, anchor | tp to X | bring to X | stare to X | rejoin", 8)
    else safeNotify("Cmd", "Unknown command: " .. cmd, 2) end
end

track(LP.Chatted:Connect(function(message)
    if not message or message == "" then return end
    local lower = message:lower():gsub("^%s+", ""):gsub("%s+$", "")
    if lower:sub(1, 1) ~= ";" and lower:sub(1, 1) ~= "/" then return end

    local tpTarget = lower:match("^[;/]tp%s+to%s+(.+)$")
    if not tpTarget then tpTarget = lower:match("^[;/]tp%s+(.+)$") end
    if not tpTarget then tpTarget = lower:match("^[;/]goto%s+to%s+(.+)$") end
    if not tpTarget then tpTarget = lower:match("^[;/]goto%s+(.+)$") end
    if tpTarget then
        tpTarget = tpTarget:gsub("%s+$", "")
        local target = findPlayerByPrefix(tpTarget)
        if target then teleportToPlayer(target); safeNotify("Chat", "Teleported to " .. target.Name, 2)
        else safeNotify("Chat", "No player matching: " .. tpTarget, 2) end
        return
    end

    local bringTarget = lower:match("^[;/]bring%s+to%s+(.+)$")
    if not bringTarget then bringTarget = lower:match("^[;/]bring%s+(.+)$") end
    if bringTarget then
        bringTarget = bringTarget:gsub("%s+$", "")
        local target = findPlayerByPrefix(bringTarget)
        if target then bringPlayer(target); safeNotify("Chat", "Brought " .. target.Name, 2)
        else safeNotify("Chat", "No player matching: " .. bringTarget, 2) end
        return
    end

    local stareTarget = lower:match("^[;/]stare%s+to%s+(.+)$")
    if not stareTarget then stareTarget = lower:match("^[;/]stare%s+(.+)$") end
    if stareTarget then
        stareTarget = stareTarget:gsub("%s+$", "")
        local target = findPlayerByPrefix(stareTarget)
        if target then stareAt(target) end
        return
    end

    pcall(executeCommand, message)
end))

local mainHB = RunService.Heartbeat:Connect(function(dt)
    if S.Fly then updateFly(dt) end
    if S.TpWalk then updateTpWalk(dt) end
    if S.WallWalk then updateWallWalk(dt) end
    if S.Float then updateFloat() else if FloatBV then destroy(FloatBV); FloatBV = nil end end
    if S.VehicleFly then updateVehicleFly() else stopVehicleFly() end
    if S.Godmode then applyGodmode() end
    if S.Noclip then setNoclip(true) end

    local hum = getHum()
    if hum then
        if S.SpeedEnabled then hum.WalkSpeed = S.Speed
        elseif hum.WalkSpeed ~= 16 then hum.WalkSpeed = 16 end
        if S.JumpEnabled then hum.UseJumpPower = true; hum.JumpPower = S.JumpPower
        elseif hum.UseJumpPower and hum.JumpPower ~= 50 then hum.JumpPower = 50 end
    end

    if S.GravityEnabled then Workspace.Gravity = S.Gravity
    elseif Workspace.Gravity ~= 196 then Workspace.Gravity = 196 end

    if S.AntiVoid then
        local root = getRoot()
        if root and root.Position.Y < -100 then
            local spawn = Workspace:FindFirstChildOfClass("SpawnLocation")
            if spawn then root.CFrame = spawn.CFrame + Vector3.new(0, 5, 0)
            else root.CFrame = CFrame.new(0, 50, 0) end
            safeNotify("Anti-Void", "Teleported back.", 2)
        end
    end

    if S.AntiFling then
        local root = getRoot()
        if root then
            for _, c in ipairs(root:GetChildren()) do
                if (c:IsA("BodyVelocity") or c:IsA("BodyAngularVelocity") or c:IsA("BodyThrust"))
                   and c ~= FlyBV and c ~= FloatBV and c ~= VehicleBV then
                    pcall(function() c:Destroy() end)
                end
            end
            pcall(function() root.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.5, 1, 1) end)
        end
    end

    if S.RGB then
        local char = getChar()
        if char then
            local hue = (tick() * S.RGBSpeed) % 1
            RGBColor = Color3.fromHSV(hue, 1, 1)
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                    pcall(function() p.Color = RGBColor; p.Material = Enum.Material.Neon end)
                end
            end
            for _, a in ipairs(char:GetChildren()) do
                if a:IsA("Accessory") then
                    for _, p in ipairs(a:GetDescendants()) do
                        if p:IsA("BasePart") then pcall(function() p.Color = RGBColor end) end
                    end
                end
            end
        end
    end
end)

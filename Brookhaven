    ensureFolder()
    if type(writefile) ~= "function" then return end
    local ok2, encoded = pcall(function() return HttpService:JSONEncode(SavedSongs) end)
    if not ok2 then return end
    pcall(writefile, SAVE_FILE, encoded)

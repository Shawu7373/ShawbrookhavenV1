local function loadSongs()
    ensureFolder()
    if type(isfile) == "function" and type(readfile) == "function" then
        local ok2, exists = pcall(isfile, SAVE_FILE)
        if ok2 and exists then
            local ok3, content = pcall(readfile, SAVE_FILE)

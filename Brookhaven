-- ===== Vehicle Fly =====
local function stopVehicleFly()
    if VehicleBV then destroy(VehicleBV); VehicleBV = nil end
    if VehicleBG then destroy(VehicleBG); VehicleBG = nil end
end

local function updateVehicleFly()
    if not S.VehicleFly then stopVehicleFly(); CachedVehicle = nil; return end
    if not CachedVehicle or not CachedVehicle.Parent then CachedVehicle = getCurrentVehicle() end
    local vehicle = CachedVehicle
    if not vehicle then stopVehicleFly(); return end
    local primary = vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart")
    if not primary then return end
    if not VehicleBV or not VehicleBV.Parent or VehicleBV.Parent ~= primary then
        stopVehicleFly()
        VehicleBV = Instance.new("BodyVelocity")
        VehicleBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        VehicleBV.P = 1250; VehicleBV.Parent = primary
        VehicleBG = Instance.new("BodyGyro")
        VehicleBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        VehicleBG.P = 9e4; VehicleBG.D = 500; VehicleBG.Parent = primary
    end
    local cam = Workspace.CurrentCamera; if not cam then return end
    local moveDir = getCameraRelativeMoveDir()
    if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
    if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end
    if moveDir.Magnitude > 0.01 then moveDir = moveDir.Unit end
    VehicleBV.Velocity = moveDir * S.VehicleFlySpeed
    VehicleBG.CFrame = cam.CFrame
end

-- ===== Force Fly / Player Effects (BUG FIXES) =====
local MAX_EFFECTS = 5

local function stopPlayerEffect(targetPlayer)
    if not targetPlayer then return end
    local eff = PlayerEffects[targetPlayer]
    if not eff then return end
    PlayerEffects[targetPlayer] = nil -- FIX: remove first to prevent double-destroy
    if eff.bv then pcall(function() eff.bv:Destroy() end) end
    if eff.bg then pcall(function() eff.bg:Destroy() end) end
    if eff.bav then pcall(function() eff.bav:Destroy() end) end
    if eff.conn then pcall(function() eff.conn:Disconnect() end) end
    if targetPlayer.Character then
        local h = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
        if h then
            pcall(function()
                h.PlatformStand = false
                h:ChangeState(Enum.HumanoidStateType.GettingUp)
            end)
        end
    end
end

local function stopAllPlayerEffects()
    -- FIX: snapshot keys before modifying
    local snapshot = {}
    for pl in pairs(PlayerEffects) do table.insert(snapshot, pl) end
    for _, pl in ipairs(snapshot) do stopPlayerEffect(pl) end
end

local function countEffects()
    local n = 0
    for _ in pairs(PlayerEffects) do n = n + 1 end
    return n
end

local function forceFlyPlayer(targetPlayer, mode)
    if not targetPlayer then safeNotify("Force Fly", "Player not found.", 2); return end
    if targetPlayer == LP then safeNotify("Force Fly", "Can't force fly yourself.", 2); return end
    if not targetPlayer.Character then safeNotify("Force Fly", "Player has no character.", 2); return end
    local root = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    local hum = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not root or not hum then safeNotify("Force Fly", "Missing root/humanoid.", 2); return end

    -- FIX: cap concurrent effects unless we're replacing one for this player
    if not PlayerEffects[targetPlayer] and countEffects() >= MAX_EFFECTS then
        safeNotify("Force Fly", "Max " .. MAX_EFFECTS .. " effects. Stop some first.", 3)
        return
    end

    stopPlayerEffect(targetPlayer)

    local eff = { type = mode }

    -- FIX: create body movers BEFORE setting PlatformStand so they don't fall during transition
    if mode == "lift" then
        eff.bv = Instance.new("BodyVelocity")
        eff.bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        eff.bv.Velocity = Vector3.new(0, 200, 0)
        eff.bv.P = 1250; eff.bv.Parent = root
    elseif mode == "hover" then
        eff.bv = Instance.new("BodyVelocity")
        eff.bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        eff.bv.Velocity = Vector3.zero
        eff.bv.P = 1250; eff.bv.Parent = root
    elseif mode == "spin" then
        eff.bav = Instance.new("BodyAngularVelocity")
        eff.bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        eff.bav.AngularVelocity = Vector3.new(0, 60, 0)
        eff.bav.P = 1250; eff.bav.Parent = root
    elseif mode == "carry" then
        eff.bv = Instance.new("BodyVelocity")
        eff.bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        eff.bv.P = 1250; eff.bv.Parent = root
        eff.conn = RunService.Heartbeat:Connect(function()
            local myRoot = getRoot()
            if not myRoot or not root.Parent or not hum.Parent then
                stopPlayerEffect(targetPlayer); return
            end
            local targetPos = myRoot.CFrame * CFrame.new(0, 3, -6)
            local delta = targetPos.Position - root.Position
            eff.bv.Velocity = delta * 10
        end)
    end

    -- FIX: set PlatformStand AFTER body movers exist
    pcall(function() hum.PlatformStand = true end)
    PlayerEffects[targetPlayer] = eff

    -- FIX: only cleanup when character is actually destroyed (newParent == nil)
    local charConn
    charConn = targetPlayer.Character.AncestryChanged:Connect(function(_, newParent)
        if newParent ~= nil then return end
        task.wait(1)
        if PlayerEffects[targetPlayer] == eff then
            stopPlayerEffect(targetPlayer)
        end
        if charConn then pcall(function() charConn:Disconnect() end) end
    end)

    local label = ({lift = "going up", hover = "hovering", spin = "spinning", carry = "following you"})[mode] or mode
    safeNotify("Force Fly", targetPlayer.Name .. " is " .. label .. ".", 3)
end

-- ===== Godmode =====
local function applyGodmode()
    if not S.Godmode then return end
    local char, hum = getChar(), getHum(); if not char or not hum then return end
    if not char:FindFirstChildOfClass("ForceField") then
        local ff = Instance.new("ForceField"); ff.Visible = false; ff.Parent = char
    end
    if hum.Health < hum.MaxHealth then pcall(function() hum.Health = hum.MaxHealth end) end
    for _, o in ipairs(char:GetDescendants()) do
        if o.Name == "Fire" or o.Name == "Injury" or o.Name == "Bleed" then destroy(o) end
    end
end

local function setNoclip(state)
    local char = getChar(); if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if state then
                if S.OriginalCollisions[part] == nil then S.OriginalCollisions[part] = part.CanCollide end
                part.CanCollide = false
            else
                part.CanCollide = S.OriginalCollisions[part] ~= false
            end
        end
    end
    if not state then S.OriginalCollisions = {} end
end


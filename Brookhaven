    end
    S.MusicPlaying = false
end

local function playMusicLocal(id, name)
    stopMusic()
    local char = getChar()
    if not char then safeNotify("Music", "Character not loaded.", 2); return end
    local sound = Instance.new("Sound")
    sound.Name = "ShawMusic"
    sound.SoundId = "rbxassetid://" .. tostring(id)
    sound.Volume = S.MusicVolume
    sound.Looped = false
    sound.Parent = char
    local success, err = pcall(function() sound:Play() end)
    if success then
        MusicSound = sound
        S.CurrentSongId = id
        S.MusicPlaying = true
        safeNotify("Music", "Playing locally: " .. (name or id), 2)
    else
        safeNotify("Music", "Failed: " .. tostring(err), 3)
        sound:Destroy()
    end
end

local function playMusicGlobal(id, name)
    if not id or id == "" then safeNotify("Music", "Enter a song ID first.", 2); return end
    local numericId = tonumber(id)
    if not numericId then safeNotify("Music", "Song ID must be a number.", 2); return end
    stopMusic()
    local remote = findBrookhavenMusicRemote()
    if remote then
        local success = pcall(function()
            if remote:IsA("RemoteEvent") then remote:FireServer(numericId)
            else remote:InvokeServer(numericId) end
        end)
        if success then
            local char = getChar()
            if char then
                local sound = Instance.new("Sound")
                sound.Name = "ShawMusic"
                sound.SoundId = "rbxassetid://" .. tostring(numericId)
                sound.Volume = S.MusicVolume
                sound.Looped = false
                sound.Parent = char
                pcall(function() sound:Play() end)
                MusicSound = sound
            end
            S.CurrentSongId = numericId
            S.MusicPlaying = true
            safeNotify("Music", "Playing globally: " .. (name or numericId), 3)
        else
            safeNotify("Music", "Remote failed. Playing locally.", 3)
            playMusicLocal(numericId, name)
        end
    else
        safeNotify("Music", "Music remote not found. Playing locally.", 3)
        playMusicLocal(numericId, name)
    end
end

local function setMusicVolume(v)
    S.MusicVolume = math.clamp(v, 0, 1)
    if MusicSound then pcall(function() MusicSound.Volume = S.MusicVolume end) end
end

--// ======================== MUSIC SAVE SYSTEM ========================
local SAVE_FOLDER = "ShawBHub"
local SAVE_FILE = SAVE_FOLDER .. "/songs.json"

local function ensureFolder()
    if type(makefolder) == "function" and type(isfolder) == "function" then
        if not isfolder(SAVE_FOLDER) then pcall(function() makefolder(SAVE_FOLDER) end) end
    end
end

local function loadSongs()
    ensureFolder()
    if type(isfile) == "function" and type(readfile) == "function" then
        local ok, exists = pcall(isfile, SAVE_FILE)
        if ok and exists then
            local ok2, content = pcall(readfile, SAVE_FILE)
            if ok2 then
                local ok3, decoded = pcall(function() return HttpService:JSONDecode(content) end)
                if ok3 and type(decoded) == "table" then
                    SavedSongs = decoded
                    print("[Shaw Hub] Loaded " .. #SavedSongs .. " saved songs")
                    return
                end
            end
        end
    end
    SavedSongs = {}
end

local function saveSongs()
    ensureFolder()
    if type(writefile) ~= "function" then
        warn("[Shaw Hub] writefile unavailable — songs not saved.")
        return
    end
    local ok, encoded = pcall(function() return HttpService:JSONEncode(SavedSongs) end)
    if not ok then warn("[Shaw Hub] JSONEncode failed."); return end
    local ok2, err = pcall(writefile, SAVE_FILE, encoded)
    if not ok2 then warn("[Shaw Hub] writefile failed: " .. tostring(err)) end
end

local function addSong(id, name)
    if not id or id == "" then return false end
    for _, s in ipairs(SavedSongs) do
        if s.id == id then safeNotify("Music", "Song ID already saved.", 2); return false end
    end
    table.insert(SavedSongs, {id = id, name = name or ("Song " .. id)})
    saveSongs()
    safeNotify("Music", "Saved: " .. (name or id), 2)
    return true
end

local function removeSong(id)
    for i, s in ipairs(SavedSongs) do
        if s.id == id then
            table.remove(SavedSongs, i)
            saveSongs()
            safeNotify("Music", "Removed: " .. (s.name or id), 2)
            return true
        end
    end
    return false
end


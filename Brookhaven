-- ===== Camera-relative input =====
local function getCameraRelativeMoveDir()
    local cam = Workspace.CurrentCamera
    if not cam then return Vector3.zero end
    local inputX, inputZ = 0, 0
    local controls = getPlayerControls()
    if controls then
        local ok2, vec = pcall(function() return controls:GetMoveVector() end)
        if ok2 and vec then inputX = vec.X; inputZ = vec.Z end
    end
    if math.abs(inputX) < 0.01 and math.abs(inputZ) < 0.01 then
        if UIS:IsKeyDown(Enum.KeyCode.W) then inputZ = inputZ + 1 end
        if UIS:IsKeyDown(Enum.KeyCode.S) then inputZ = inputZ - 1 end
        if UIS:IsKeyDown(Enum.KeyCode.D) then inputX = inputX + 1 end
        if UIS:IsKeyDown(Enum.KeyCode.A) then inputX = inputX - 1 end
    end
    local camLook = cam.CFrame.LookVector
    local camRight = cam.CFrame.RightVector
    return (camLook * inputZ) + (camRight * inputX)
end

-- ===== Music =====
local function findBrookhavenMusicRemote()
    if MusicRemoteChecked then return MusicRemote end
    MusicRemoteChecked = true
    local candidates = {"PlayMusic","MusicEvent","PlaySong","SetMusic","RadioEvent","MusicRemote","BoomboxEvent","PlayAudio","SoundEvent","FireMusic","SongEvent","Music","Radio","Boombox"}
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local lower = obj.Name:lower()
            for _, name in ipairs(candidates) do
                if lower == name:lower() or lower:find(name:lower()) then
                    MusicRemote = obj; return obj
                end
            end
        end
    end
    return nil
end

local function stopMusic()
    if MusicSound then
        pcall(function() MusicSound:Stop() end)
        pcall(function() MusicSound:Destroy() end)
        MusicSound = nil
    end
    S.MusicPlaying = false
end

local function playMusicLocal(id, name)
    stopMusic()
    local char = getChar(); if not char then safeNotify("Music", "Character not loaded.", 2); return end
    local sound = Instance.new("Sound")
    sound.Name = "ShawMusic"; sound.SoundId = "rbxassetid://" .. tostring(id)
    sound.Volume = S.MusicVolume; sound.Looped = false; sound.Parent = char
    local ok2, err2 = pcall(function() sound:Play() end)
    if ok2 then
        MusicSound = sound; S.CurrentSongId = id; S.MusicPlaying = true
        safeNotify("Music", "Playing locally: " .. (name or id), 2)
    else
        safeNotify("Music", "Failed: " .. tostring(err2), 3); sound:Destroy()
    end
end

local function playMusicGlobal(id, name)
    if not id or id == "" then safeNotify("Music", "Enter a song ID first.", 2); return end
    local numericId = tonumber(id)
    if not numericId then safeNotify("Music", "Song ID must be a number.", 2); return end
    stopMusic()
    local remote = findBrookhavenMusicRemote()
    if remote then
        local ok2 = pcall(function()
            if remote:IsA("RemoteEvent") then remote:FireServer(numericId)
            else remote:InvokeServer(numericId) end
        end)
        if ok2 then
            local char = getChar()
            if char then
                local sound = Instance.new("Sound")
                sound.Name = "ShawMusic"; sound.SoundId = "rbxassetid://" .. tostring(numericId)
                sound.Volume = S.MusicVolume * 0.5; sound.Looped = false; sound.Parent = char
                pcall(function() sound:Play() end); MusicSound = sound
            end
            S.CurrentSongId = numericId; S.MusicPlaying = true
            safeNotify("Music", "Playing globally: " .. (name or numericId), 3)
        else
            safeNotify("Music", "Remote failed. Playing locally.", 3)
            playMusicLocal(numericId, name)
        end
    else
        safeNotify("Music", "Music remote not found. Playing locally.", 3)
        playMusicLocal(numericId, name)
    end
end

local function setMusicVolume(v)
    S.MusicVolume = math.clamp(v, 0, 1)

-- ===== CLEANUP =====
getgenv().ShawBHub = function()
    stopFly(); stopVehicleFly(); stopMusic(); stopAllPlayerEffects()
    S.Godmode = false; S.Noclip = false; S.ESP = false; S.RGB = false
    S.Invisible = false; S.AntiVoid = false; S.AntiFling = false
    S.AutoCollect = false; S.Fly = false; S.TpWalk = false
    S.WallWalk = false; S.Float = false; S.VehicleFly = false
    if S.Anchor then setAnchor(false) end
    for _, c in ipairs(Conn) do pcall(function() c:Disconnect() end) end
    Conn = {}
    cleanupAllESP()
    if FlyBV then destroy(FlyBV); FlyBV = nil end
    if FlyBG then destroy(FlyBG); FlyBG = nil end
    if FloatBV then destroy(FloatBV); FloatBV = nil end
    if MusicSound then destroy(MusicSound); MusicSound = nil end
    MusicRemote = nil; MusicRemoteChecked = false; StareTarget = nil
    CachedVehicle = nil; CachedGPUnlockRemotes = nil
    local char = getChar()
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                pcall(function()
                    p.CanCollide = true; p.Transparency = 0
                    p.LocalTransparencyModifier = 0; p.Anchored = false
                end)
            end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum.WalkSpeed = 16; hum.JumpPower = 50; hum.UseJumpPower = true
                hum.PlatformStand = false; hum.AutoRotate = true
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end)
        end
    end
    Workspace.Gravity = 196
    Lighting.Ambient = S.OriginalLighting.Ambient
    Lighting.OutdoorAmbient = S.OriginalLighting.OutdoorAmbient
    Lighting.Brightness = S.OriginalLighting.Brightness
    Lighting.FogEnd = S.OriginalLighting.FogEnd
    Lighting.FogStart = S.OriginalLighting.FogStart
    Lighting.ClockTime = S.OriginalLighting.ClockTime

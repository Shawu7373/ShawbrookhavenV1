-- ===== Prefix Finder =====
local function findPlayerByPrefix()
    if not prefix or prefix == "" then return nil end
    local p = prefix:lower()
    if p == "r" or p == "random" then
        local others = {}
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LP then table.insert(others, pl) end
        end
        if #others == 0 then return nil end
        return others[math.random(1, #others)]
    end
    local prefixMatch = nil
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP then
            local nameLower = pl.Name:lower()
            local dispLower = pl.DisplayName:lower()
            if nameLower == p or dispLower == p then return pl end
            if not prefixMatch then
                if nameLower:sub(1, #p) == p or dispLower:sub(1, #p) == p then
                    prefixMatch = pl
                end
            end
        end
    end
    return prefixMatch
end

-- ===== Command Parser =====
local function executeCommand(text)
    if not text then return end
    text = text:gsub("^;", ""):gsub("^/", ""):gsub("^%s+", ""):gsub("%s+$", "")
    local args = {}
    for word in text:gmatch("%S+") do table.insert(args, word) end
    if #args == 0 then return end
    local cmd = args[1]:lower()
    local a1 = args[2]; local a2 = args[3]

    -- Self
    if cmd == "fly" then S.Fly = true; startFly(); safeNotify("Cmd", "Fly ON", 2)
    elseif cmd == "unfly" then S.Fly = false; stopFly(); safeNotify("Cmd", "Fly OFF", 2)
    elseif cmd == "speed" then local n = tonumber(a1); if n then S.Speed = n; S.SpeedEnabled = true; safeNotify("Cmd", "Speed = " .. n, 2) end
    elseif cmd == "jump" then local n = tonumber(a1); if n then S.JumpPower = n; S.JumpEnabled = true; safeNotify("Cmd", "Jump = " .. n, 2) end
    elseif cmd == "gravity" then local n = tonumber(a1); if n then S.Gravity = n; S.GravityEnabled = true; safeNotify("Cmd", "Gravity = " .. n, 2) end
    elseif cmd == "noclip" then S.Noclip = true; setNoclip(true); safeNotify("Cmd", "Noclip ON", 2)
    elseif cmd == "clip" or cmd == "unnoclip" then S.Noclip = false; setNoclip(false); safeNotify("Cmd", "Noclip OFF", 2)
    elseif cmd == "god" then S.Godmode = true; safeNotify("Cmd", "God ON", 2)
    elseif cmd == "ungod" then S.Godmode = false; safeNotify("Cmd", "God OFF", 2)
    elseif cmd == "heal" then
        if a1 then local t = findPlayerByPrefix(a1); if t then healPlayer(t) end
        else healSelf() end
    elseif cmd == "feed" then feedSelf()
    elseif cmd == "invisible" then
        if a1 then
            local t = findPlayerByPrefix(a1)
            if t and t.Character then
                for _, pt in ipairs(t.Character:GetDescendants()) do
                    if pt:IsA("BasePart") then pcall(function() pt.Transparency = 1 end) end
                end
                safeNotify("Invisible", t.Name .. " hidden (local)", 2)
            end
        else
            S.Invisible = true; applyInvisibility(); safeNotify("Cmd", "Invisible ON", 2)
        end
    elseif cmd == "visible" then
        if a1 then
            local t = findPlayerByPrefix(a1)
            if t and t.Character then
                for _, pt in ipairs(t.Character:GetDescendants()) do
                    if pt:IsA("BasePart") then pcall(function() pt.Transparency = 0 end) end
                end
            end
        else
            S.Invisible = false; applyInvisibility(); safeNotify("Cmd", "Visible", 2)
        end
    elseif cmd == "tpwalk" then S.TpWalk = not S.TpWalk; safeNotify("Cmd", "TpWalk: " .. tostring(S.TpWalk), 2)
    elseif cmd == "wallwalk" then S.WallWalk = not S.WallWalk; safeNotify("Cmd", "WallWalk: " .. tostring(S.WallWalk), 2)
    elseif cmd == "float" then S.Float = not S.Float; safeNotify("Cmd", "Float: " .. tostring(S.Float), 2)
    elseif cmd == "anchor" then S.Anchor = not S.Anchor; setAnchor(S.Anchor); safeNotify("Cmd", "Anchor: " .. tostring(S.Anchor), 2)

    -- Target
    elseif cmd == "goto" or cmd == "tp" then
        local targetStr = a1
        if targetStr and targetStr:lower() == "to" then targetStr = a2 end
        if targetStr then
            local target = findPlayerByPrefix(targetStr)
            if target then teleportToPlayer(target)
            else safeNotify("Cmd", "No player matching: " .. targetStr, 2) end
        else safeNotify("Cmd", "Usage: ;tp to r | ;tp to ca", 2) end
    elseif cmd == "bring" then
        local targetStr = a1
        if targetStr and targetStr:lower() == "to" then targetStr = a2 end
        if targetStr then
            local target = findPlayerByPrefix(targetStr)
            if target then bringPlayer(target)
            else safeNotify("Cmd", "No player matching: " .. targetStr, 2) end
        end
    elseif cmd == "stare" then
        local targetStr = a1
        if targetStr and targetStr:lower() == "to" then targetStr = a2 end
        if targetStr then
            local target = findPlayerByPrefix(targetStr)
            if target then stareAt(target) end
        end
    elseif cmd == "kill" then
        if a1 then local t = findPlayerByPrefix(a1); if t then killPlayer(t) end
        else safeNotify("Cmd", "Usage: ;kill ca", 2) end
    elseif cmd == "freeze" then
        if a1 then local t = findPlayerByPrefix(a1); if t then freezePlayer(t) end
        else freezeAll() end
    elseif cmd == "unfreeze" then
        if a1 then local t = findPlayerByPrefix(a1); if t then unfreezePlayer(t) end
        else unfreezeAll() end
    elseif cmd == "fling" then
        if a1 then local t = findPlayerByPrefix(a1); if t then flingPlayer(t) end
        else flingAll() end
    elseif cmd == "reset" then
        if a1 then
            local t = findPlayerByPrefix(a1)
            if t then resetPlayer(t) end
        else
            local h = getHum(); if h then h.Health = 0 end
            safeNotify("Cmd", "Reset self", 2)
        end
    elseif cmd == "ws" or cmd == "setspeed" then
        if a1 and a2 then
            local n = tonumber(a2)
            if n then
                local t = findPlayerByPrefix(a1)
                if t then setSpeedPlayer(t, n) end
            else safeNotify("Cmd", "Number needed: ;ws ca 100", 2) end
        else safeNotify("Cmd", "Usage: ;ws ca 100", 2) end
    elseif cmd == "jp" or cmd == "setjump" then
        if a1 and a2 then
            local n = tonumber(a2)
            if n then
                local t = findPlayerByPrefix(a1)
                if t then setJumpPlayer(t, n) end
            else safeNotify("Cmd", "Number needed: ;jp ca 100", 2) end
        else safeNotify("Cmd", "Usage: ;jp ca 100", 2) end
    elseif cmd == "age" then
        if a1 then local t = findPlayerByPrefix(a1); if t then showAge(t) end
        else showAge(LP) end

    -- Force Fly
    elseif cmd == "ff" or cmd == "flyplayer" then
        if a1 then
            local t = findPlayerByPrefix(a1)
            if t then forceFlyPlayer(t, a2 or "lift")
            else safeNotify("Cmd", "No player matching: " .. a1, 2) end
        else safeNotify("Cmd", "Usage: ;ff ca lift/hover/spin/carry", 3) end
    elseif cmd == "stopfly" then
        if a1 then
            local t = findPlayerByPrefix(a1)
            if t then stopPlayerEffect(t); safeNotify("Cmd", "Stopped " .. t.Name, 2)
            else safeNotify("Cmd", "No player matching: " .. a1, 2) end
        else stopAllPlayerEffects(); safeNotify("Cmd", "St foropped all effects", 2) end
    elseif cmd == "stopall" then
        stopAllPlayerEffects(); safeNotify("Cmd", "Stopped all effects", 2)

    -- Global
    elseif cmd == "bringall" then bringAllPlayers()
    elseif cmd == "flingall" then flingAll()
    elseif cmd == "unfreezeall" then unfreezeAll()

    -- Utility
    elseif cmd == "time" then
        if a1 then setTimeOfDay(a1) else safeNotify("Cmd", "Usage: ;time day", 2) end
    elseif cmd == "fog" then
        if a1 == "on" then toggleFog(true)
        elseif a1 == "off" then toggleFog(false)
        else toggleFog(true) end
    elseif cmd == "rejoin" then pcall(function() TeleportService:Teleport(game.PlaceId, LP) end)
    elseif cmd == "help" then
        safeNotify("Help 1/3", "SELF: fly, unfly, speed N, jump N, gravity N, noclip, clip, god, ungod, heal, feed, invisible, visible, tpwalk, wallwalk, float, anchor", 10)
        task.wait(0.5)
        safeNotify("Help 2/3", "TARGET: ;tp to X, ;bring X, ;stare X, ;kill X, ;freeze X, ;unfreeze X, ;fling X, ;reset X, ;heal X, ;ws X N, ;jp X N, ;age X, ;invisible X, ;visible X", 10)
        task.wait(0.5)
        safeNotify("Help 3/3", "FORCE FLY: ;ff X lift/hover/spin/carry, ;stopfly X, ;stopall | GLOBAL: ;freeze, ;fling, ;bringall, ;flingall, ;unfreezeall | WORLD: ;time day/night, ;fog on/off, ;rejoin", 10)
    else safeNotify("Cmd", "Unknown: " .. cmd .. " (type ;help)", 2) end
end


local function stopFly()
    if FlyBV then destroy(FlyBV); FlyBV = nil end
    if FlyBG then destroy(FlyBG); FlyBG = nil end
    local hum = getHum()
    if hum then
        pcall(function()
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            hum.AutoRotate = true
        end)
    end
    S.FlyCurrentSpeed = 0
    setFlyPadVisible(false)
end

local function updateFly(dt)
    if not S.Fly then return end
    local hum, root = getHum(), getRoot()
    if not hum or not root or not FlyBV or not FlyBG then return end
    local cam = Workspace.CurrentCamera
    if not cam then return end

    local moveDir = Vector3.zero
    local camLook = cam.CFrame.LookVector
    local camRight = cam.CFrame.RightVector

    if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camLook end
    if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camLook end
    if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camRight end
    if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camRight end
    if flyUp then moveDir = moveDir + camLook end
    if flyDown then moveDir = moveDir - camLook end
    if flyLeft then moveDir = moveDir - camRight end
    if flyRight then moveDir = moveDir + camRight end
    if UIS:IsKeyDown(Enum.KeyCode.Space) or flyUpBtn then moveDir = moveDir + Vector3.new(0, 1, 0) end
    if UIS:IsKeyDown(Enum.KeyCode.LeftShift) or flyDownBtn then moveDir = moveDir - Vector3.new(0, 1, 0) end

    if moveDir.Magnitude > 0.01 then moveDir = moveDir.Unit end
    local targetSpeed = (moveDir.Magnitude > 0.01) and S.FlySpeed or 0
    local rampRate = 4
    if S.FlyCurrentSpeed < targetSpeed then
        S.FlyCurrentSpeed = math.min(S.FlyCurrentSpeed + rampRate * dt * 60, targetSpeed)
    elseif S.FlyCurrentSpeed > targetSpeed then
        S.FlyCurrentSpeed = math.max(S.FlyCurrentSpeed - rampRate * dt * 60, targetSpeed)
    end
    FlyBV.Velocity = moveDir * S.FlyCurrentSpeed
    FlyBG.CFrame = cam.CFrame
end

--// ======================== TP WALK ========================
local function updateTpWalk(dt)
    if not S.TpWalk then return end
    local hum, root = getHum(), getRoot()
    if not hum or not root then return end
    local md = hum.MoveDirection
    if md.Magnitude > 0.01 then
        local newPos = root.Position + md * S.TpWalkSpeed * dt
        local char = getChar()
        local rp = RaycastParams.new()
        rp.FilterDescendantsInstances = {char}
        rp.FilterType = Enum.RaycastFilterType.Exclude
        local hit = Workspace:Raycast(newPos + Vector3.new(0, 5, 0), Vector3.new(0, -20, 0), rp)
        if hit then
            newPos = Vector3.new(newPos.X, hit.Position.Y + root.Size.Y / 2 + 0.1, newPos.Z)
        end
        root.CFrame = CFrame.new(newPos, newPos + root.CFrame.LookVector)
    end
end

--// ======================== WALL WALK ========================
local lastWallScan = 0
local function updateWallWalk(dt)
    if not S.WallWalk then return end
    if tick() - lastWallScan < 0.1 then return end
    lastWallScan = tick()
    local char, root = getChar(), getRoot()
    if not char or not root then return end
    if not UIS:IsKeyDown(Enum.KeyCode.Space) then return end
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {char}
    params.FilterType = Enum.RaycastFilterType.Exclude
    local dirs = {
        root.CFrame.LookVector,
        -root.CFrame.LookVector,
        root.CFrame.RightVector,
        -root.CFrame.RightVector
    }
    for _, dir in ipairs(dirs) do
        local result = Workspace:Raycast(root.Position, dir * 3, params)
        if result then
            local vel = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(vel.X, math.max(vel.Y, S.WallWalkSpeed), vel.Z)
            return
        end
    end
end

